# Latidos padrão. Este arquivo serve como um template para futuros tipos de latidos e como um recurso para mobs que não possuem latidos únicos por um motivo ou outro.

# Recomendações:
# - Tente manter os latidos simples e razoavelmente curtos. O limite usual é de 8 palavras, mas a maioria dos latidos deve ter no máximo 3 palavras.
# - Cada latido deve ter uma ou, no máximo, duas frases.
# - Lembre-se de que esses latidos geralmente não serão entendidos pelos jogadores.
# - Não adicione pontuação no final da mensagem, exceto por pontos de interrogação, para que o sistema de latidos aleatórios adicione pontuação aleatória.

bark-default-1 = Latir
bark-default-2 = Uivo
bark-default-3 = Latidos
bark-default-4 = Rosnado
bark-default-5 = Eeeeeee
bark-default-6 = Latidinhos
bark-default-7 = Awooooooooooooooooooo awooo awoooo
bark-default-8 = Grrrrrrrrrrrrrrrrrr
bark-default-9 = Rarrwrarrwr
bark-default-10 = CARALHO como eu amo biscoitos de peixinho dourado
bark-default-11 = Bork bork boof boof bork bork boof boof bork
bark-default-12 = Latir
bark-default-13 = Uivo
bark-default-14 = Latidos
bark-default-15 = Rosnado
bark-default-16 = Eeeeeee
bark-default-17 = Latidinhos

# Este sempre deve ser o último para que seja fácil de acompanhar.
# A contagem de latidos é específica para cada localidade, por isso geralmente são definidos em arquivos FTL em vez de YML, para facilitar a localização.

bark-default-count = 17

