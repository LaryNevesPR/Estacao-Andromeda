execution-verb-name = Executar
execution-verb-message = Use sua arma para executar alguém.

# Todas as strings de localização abaixo têm acesso às seguintes variáveis
# attacker (a pessoa que está cometendo a execução)
# victim (a pessoa que está sendo executada)
# weapon (a arma usada para a execução)

execution-popup-melee-initial-internal = Você prepara {THE($weapon)} contra a garganta de {$victim}.
execution-popup-melee-initial-external = {$attacker} prepara {POSS-ADJ($attacker)} {$weapon} contra a garganta de {$victim}.
execution-popup-melee-complete-internal = Você corta a garganta de {$victim}!
execution-popup-melee-complete-external = {$attacker} corta a garganta de {$victim}!

execution-popup-self-initial-internal = Você prepara {THE($weapon)} contra sua própria garganta.
execution-popup-self-initial-external = {$attacker} prepara {POSS-ADJ($attacker)} {$weapon} contra sua própria garganta.
execution-popup-self-complete-internal = Você corta sua própria garganta!
execution-popup-self-complete-external = {$attacker} corta sua própria garganta!
