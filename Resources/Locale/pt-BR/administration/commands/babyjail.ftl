cmd-babyjail-desc = Alterna a prisão de bebês, que habilita restrições mais rigorosas sobre quem pode entrar no servidor.
cmd-babyjail-help = Uso: babyjail
babyjail-command-enabled = A prisão de bebês foi habilitada.
babyjail-command-disabled = A prisão de bebês foi desativada.

cmd-babyjail_show_reason-desc = Alterna se os clientes conectados verão ou não o motivo pelo qual a prisão de bebês os bloqueou de se conectar.
cmd-babyjail_show_reason-help = Uso: babyjail_show_reason
babyjail-command-show-reason-enabled = A prisão de bebês agora mostrará um motivo para os usuários que bloqueia de se conectar.
babyjail-command-show-reason-disabled = A prisão de bebês não mostrará mais um motivo para os usuários que bloqueia de se conectar.

cmd-babyjail_max_account_age-desc = Obtém ou define a idade máxima da conta em minutos que uma conta pode ter para ser permitida a conexão com a prisão de bebês ativada.
cmd-babyjail_max_account_age-help = Uso: babyjail_max_account_age <horas>
babyjail-command-max-account-age-is = A idade máxima da conta para a prisão de bebês é de {$hours} horas.
babyjail-command-max-account-age-set = Definir a idade máxima da conta para a prisão de bebês para {$hours} horas.

cmd-babyjail_max_overall_hours-desc = Obtém ou define o tempo total de jogo em minutos que uma conta pode ter para ser permitida a conexão com a prisão de bebês ativada.
cmd-babyjail_max_overall_hours-help = Uso: babyjail_max_overall_hours <horas>
babyjail-command-max-overall-hours-is = O tempo total de jogo para a prisão de bebês é de {$hours} horas.
babyjail-command-max-overall-hours-set = Definir o tempo total de jogo para a prisão de bebês para {$hours} horas.

