supermatter-examine-integrity =
    Sua integridade é de [color=yellow]{$integrity}%[/color].
supermatter-healing =
    Hiperestrutura cristalina retornando aos parâmetros operacionais seguros. Integridade: {$integrity}%.
supermatter-warning =
    Aviso! Integridade da hiperestrutura cristalina falhando! Integridade: {$integrity}%.
supermatter-emergency =
    PERIGO! Integridade da hiperestrutura cristalina atingindo níveis críticos! Integridade: {$integrity}%.
supermatter-delam-explosion =
    DESLAMINAÇÃO DO CRISTAL IMINENTE! O cristal atingiu falha crítica de integridade! Campo de desestabilização de causalidade de emergência foi ativado.
supermatter-delam-overmass =
    DESLAMINAÇÃO DO CRISTAL IMINENTE! Integridade da hiperestrutura cristalina atingiu falha crítica de massa! Formação de singularidade iminente!
supermatter-delam-tesla =
    DESLAMINAÇÃO DO CRISTAL IMINENTE! Integridade da hiperestrutura cristalina atingiu falha crítica de surto de energia! Formação de bola de energia iminente!
supermatter-delam-cascade =
    DESLAMINAÇÃO DO CRISTAL IMINENTE! Limites de frequência harmônica excedidos, campo de desestabilização de causalidade não pôde ser ativado!
supermatter-delam-cancel =
    Hiperestrutura cristalina retornando aos parâmetros operacionais seguros. Dispositivo de segurança foi desativado. Integridade: {$integrity}%.
supermatter-delam-player =
    Você sente a realidade distorcer por um momento...
supermatter-seconds-before-delam =
    Tempo estimado antes da deslaminação: {$seconds} segundos.
supermatter-seconds-before-delam-countdown =
    Restam {$seconds} segundos antes da estabilização da causalidade.
supermatter-seconds-before-delam-imminent =
    {$seconds}...

supermatter-tamper-begin =
    Você começa a cortar cuidadosamente um pedaço do cristal de supermatéria...
supermatter-tamper-end =
    Você sente o poder de mil sóis em suas mãos. Ou é toda a radiação?
supermatter-announcement-cc-tamper =
    Nosso sistema automático de casualidade detectou que a integridade estrutural do cristal de supermatéria foi comprometida por uma força externa.
    Departamento de engenharia, reporte-se ao motor de supermatéria imediatamente.

supermatter-collide =
    {CAPITALIZE(O($target))} colide com {$sm}!
supermatter-collide-mob =
    O corpo de {CAPITALIZE(O($target))} transforma-se em pó!
